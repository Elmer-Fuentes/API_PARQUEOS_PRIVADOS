# --- Configuración de duración de tokens JWT ---
# Autor: Elmer Fuentes
# JWT_LOGIN_MINUTES  -> duración del refreshToken (payload.tipo = "login").
#                        Usado SOLO para /auth/renovar-sesion y /auth/logout.
#                        Definición: 7 días (168 horas).
# JWT_SESSION_MINUTES -> duración del accessToken (payload.tipo = "session").
#                        Usado para consumir los endpoints CRUD protegidos.
#                        Definición: 15 segundos.
# Formato aceptado por duracionJwtEnMinutos(): número sin sufijo = minutos,
# o número con sufijo s (segundos), m (minutos) o h (horas).
JWT_SECRET=ParqueoPrivadosGT_Cambiar_Este_Secreto_2026
JWT_LOGIN_MINUTES=1h
JWT_SESSION_MINUTES=15s
