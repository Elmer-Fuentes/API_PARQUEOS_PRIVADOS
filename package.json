{
  "name": "parqueo-privados-gt-api",
  "version": "1.0.0",
  "description": "API REST Parqueo Privados GT - Practica Semana 9",
  "author": "Elmer Fuentes",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main.js",
    "lint": "oxlint --config oxlint.json --deny-warnings src/ test/",
    "test": "npm run build && vitest run",
    "test:e2e": "npm run build && vitest run --config vitest.config.e2e.ts",
    "typecheck": "npm run build && tsc --noEmit --incremental false",
    "db:check": "node --env-file=.env scripts/check-database.mjs",
    "db:migrate": "node --env-file=.env scripts/migrate-auth.mjs",
    "test:db": "npm run build && node --env-file=.env scripts/test-database.mjs"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.0",
    "@nestjs/config": "^4.0.3",
    "@nestjs/core": "^11.2.0",
    "@nestjs/platform-express": "^11.2.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "pg": "^8.23.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "@nestjs/mapped-types": "^2.1.0",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/swagger": "^11.2.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.2.0",
    "@types/express": "^5.0.0",
    "@types/node": "^24.13.4",
    "@types/pg": "^8.23.1",
    "oxlint": "^1.58.0",
    "prettier": "^3.4.2",
    "typescript": "^6.0.2",
    "vitest": "^4.1.11"
  }
}
